# OpenAI 兼容端点：OpenAI / DeepSeek / Qwen / Ollama / vLLM 均可
CODEERRATUM_BASE_URL=https://api.openai.com/v1
# 本地端点（如 Ollama）可留空
CODEERRATUM_API_KEY=sk-your-key-here
# 建议固定到具体版本快照，不用 latest，保证结果可复现
CODEERRATUM_MODEL=gpt-4o-2024-11-20

# ---- 超时与并发（一般不用改）----
# 单次读取窗口（秒）。生成上限 8192 token、实测约 50 token/s，满长度需要 ~165s，
# 所以默认 240s；推理型模型（思考 token 也算生成）可调到 420。
# CODEERRATUM_READ_TIMEOUT=240
# 每个单元的输出上限；端点有硬上限时调小
# CODEERRATUM_REVIEW_MAX_TOKENS=8192
# 同一模型同时在跑的单元数
# CODEERRATUM_UNIT_CONCURRENCY=4

# ---- 第三期：异构多模型（可选，单模型留空即可）----
# 两家不同厂商 = dual；三家 = committee；family 是异构判据，同厂商不算异构。
# 证伪轮优先用第三家；未配第三家则在审查模型间交叉证伪。
# CODEERRATUM_MODE=dual
# CODEERRATUM_MODELS=[
#   {"model_id":"gpt-4o-2024-11-20","base_url":"https://api.openai.com/v1","api_key":"sk-...","family":"openai"},
#   {"model_id":"claude-3-5-sonnet-20241022","base_url":"https://api.anthropic.com/v1","api_key":"sk-...","family":"anthropic"},
#   {"model_id":"deepseek-chat","base_url":"https://api.deepseek.com/v1","api_key":"sk-...","family":"deepseek"}
# ]
